# Copy to .env. Do not commit .env.
APP_ENV=development

FRONTEND_URL=http://localhost:8000
API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000
PORT=8000

# Clerk development instance. Never put the secret key in frontend code.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# PEM public key from the Clerk dashboard. Enables networkless JWT verification.
CLERK_JWT_KEY=
# Optional. When set, session tokens must include this aud claim.
CLERK_AUDIENCE=
# Optional. Derived from CLERK_PUBLISHABLE_KEY when omitted.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:8000

FIRESTORE_PROJECT_ID=astromedica-local
FIRESTORE_EMULATOR_HOST=firestore:8080

PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Enable only when Cloudflare or another trusted proxy is the immediate caller.
TRUST_CLOUDFLARE=false
TRUST_PROXY=false
MAX_BODY_BYTES=262144
WEB_CONCURRENCY=2
